import { RequirementPriority, RequirementEnforcement } from '@prisma/client';
import {
  IsArray,
  IsBoolean,
  IsDateString,
  IsEnum,
  IsInt,
  IsNotEmpty,
  IsNumber,
  IsOptional,
  IsString,
  ValidateNested,
} from 'class-validator';
import { Type } from 'class-transformer';

export class CreateOrderPpeRequirementDto {
  @IsString()
  @IsNotEmpty()
  ppeTypeId: string;

  @IsOptional()
  @IsString()
  priority?: RequirementPriority;

  @IsOptional()
  @IsEnum(RequirementEnforcement)
  enforcement?: RequirementEnforcement;

  @IsOptional()
  @IsString()
  notes?: string;
}

export class CreateOrderToolRequirementDto {
  @IsString()
  @IsNotEmpty()
  toolId: string;

  @IsOptional()
  @IsString()
  priority?: RequirementPriority;

  @IsOptional()
  @IsEnum(RequirementEnforcement)
  enforcement?: RequirementEnforcement;

  @IsOptional()
  @IsString()
  notes?: string;
}

export class CreateOrderCertRequirementDto {
  @IsString()
  @IsNotEmpty()
  certTypeId: string;

  @IsOptional()
  @IsString()
  priority?: RequirementPriority;

  @IsOptional()
  @IsEnum(RequirementEnforcement)
  enforcement?: RequirementEnforcement;

  @IsOptional()
  @IsBoolean()
  isTrainable?: boolean;

  @IsOptional()
  @IsString()
  notes?: string;
}

export class CreateOrderComplianceRequirementDto {
  @IsString()
  @IsNotEmpty()
  requirementTypeId: string;

  @IsOptional()
  @IsString()
  variantId?: string;

  @IsOptional()
  @IsString()
  notes?: string;
}

export class CreateRampRowDto {
  @IsDateString()
  startDate: string;

  @IsDateString()
  endDate: string;

  @Type(() => Number)
  @IsInt()
  headcount: number;
}

export class CreateOrderTradeRequirementDto {
  @IsString()
  @IsNotEmpty()
  tradeId: string;

  @IsOptional()
  @IsString()
  specializationId?: string;

  @IsOptional()
  @IsArray()
  @IsString({ each: true })
  capabilityIds?: string[];

  @IsOptional()
  @IsString()
  priority?: RequirementPriority;

  @IsOptional()
  @IsEnum(RequirementEnforcement)
  enforcement?: RequirementEnforcement;

  @IsOptional()
  @IsString()
  notes?: string;

  @IsOptional()
  @IsString()
  basePayRate?: string;

  @IsOptional()
  @IsString()
  baseBillRate?: string;

  @IsOptional()
  @Type(() => Number)
  @IsInt()
  requestedHeadcount?: number;

  @IsOptional()
  @IsDateString()
  startDate?: string;

  @IsOptional()
  @IsDateString()
  expectedEndDate?: string;

  @IsOptional()
  @IsBoolean()
  supervisorOverride?: boolean;

  @IsOptional()
  @IsString()
  supervisorContactId?: string;

  @IsOptional()
  @Type(() => Number)
  @IsNumber()
  otBillRate?: number;

  @IsOptional()
  @Type(() => Number)
  @IsNumber()
  dtBillRate?: number;

  @IsOptional()
  @Type(() => Number)
  @IsNumber()
  estimatedRegHoursPerWeek?: number;

  @IsOptional()
  @Type(() => Number)
  @IsNumber()
  estimatedOtHoursPerWeek?: number;

  @IsOptional()
  @Type(() => Number)
  @IsNumber()
  estimatedDtHoursPerWeek?: number;

  @IsOptional()
  @Type(() => Number)
  @IsInt()
  estimatedWorkDaysPerWeek?: number;

  @IsOptional()
  @Type(() => Number)
  @IsNumber()
  perDiemDaysPerWeek?: number;

  @IsOptional()
  @Type(() => Number)
  @IsInt()
  estimatedDurationWeeks?: number;

  @IsOptional()
  @IsArray()
  @ValidateNested({ each: true })
  @Type(() => CreateOrderPpeRequirementDto)
  ppeRequirements?: CreateOrderPpeRequirementDto[];

  @IsOptional()
  @IsArray()
  @ValidateNested({ each: true })
  @Type(() => CreateOrderToolRequirementDto)
  toolRequirements?: CreateOrderToolRequirementDto[];

  @IsOptional()
  @IsArray()
  @ValidateNested({ each: true })
  @Type(() => CreateOrderCertRequirementDto)
  certRequirements?: CreateOrderCertRequirementDto[];

  @IsOptional()
  @IsArray()
  @ValidateNested({ each: true })
  @Type(() => CreateOrderComplianceRequirementDto)
  complianceRequirements?: CreateOrderComplianceRequirementDto[];

  @IsOptional()
  @IsArray()
  @ValidateNested({ each: true })
  @Type(() => CreateRampRowDto)
  rampSchedule?: CreateRampRowDto[];
}

export class CreateJobOrderContactDto {
  @IsString()
  @IsNotEmpty()
  customerContactId: string;

  @IsString()
  @IsNotEmpty()
  role: string;

  @IsOptional()
  @IsBoolean()
  isPrimary?: boolean;
}

export class CreateOrderDto {
  @IsOptional()
  @IsString()
  title?: string;

  @IsString()
  @IsNotEmpty()
  customerId: string;

  @IsOptional()
  @Type(() => Number)
  @IsNumber()
  sdPayDeltaRate?: number;

  @IsOptional()
  @Type(() => Number)
  @IsNumber()
  sdBillDeltaRate?: number;

  @IsOptional()
  @IsString()
  commissionPlanId?: string;

  @IsOptional()
  @IsString()
  jobSiteName?: string;

  @IsOptional()
  @IsString()
  jobSiteAddress1?: string;

  @IsOptional()
  @IsString()
  jobSiteAddress2?: string;

  @IsOptional()
  @IsString()
  jobSiteCity?: string;

  @IsOptional()
  @IsString()
  jobSiteState?: string;

  @IsOptional()
  @IsString()
  jobSiteZip?: string;

  @IsOptional()
  @IsString()
  jobSiteNotes?: string;

  @IsOptional()
  @IsArray()
  @ValidateNested({ each: true })
  @Type(() => CreateJobOrderContactDto)
  contacts?: CreateJobOrderContactDto[];

  @IsOptional()
  @IsBoolean()
  isOsep?: boolean;

  @IsOptional()
  @IsArray()
  @ValidateNested({ each: true })
  @Type(() => CreateOrderTradeRequirementDto)
  tradeRequirements?: CreateOrderTradeRequirementDto[];
}
